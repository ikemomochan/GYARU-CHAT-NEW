# Copy this file to .env and set the API key.
OPENAI_API_KEY=sk-your-key-here

# Active dialogue architecture. Add a provider adapter to use Qwen/Gemma/etc.
LLM_PROVIDER=openai
STRATEGY_MODEL=gpt-5.6-luna
RESPONSE_MODEL=gpt-5.6-luna
TONE_MODEL=gpt-5.6-luna
STYLE_TOP_K=5
PRINCIPLE_RAG_TOP_K=5
STYLE_EXAMPLES_PATH=data/gyaru_rag_documents.jsonl
STYLE_CACHE_PATH=.data/style_embeddings.json
PRINCIPLE_RAG_PATH=data/gyaru_principles_rag.jsonl
PRINCIPLE_RAG_CACHE_PATH=.data/gyaru_principle_embeddings.json

# Legacy Mem0/RAG settings retained for the inactive implementation modules.
OPENAI_CHAT_MODEL=gpt-5.6-luna
OPENAI_STYLE_MODEL=gpt-5.6-luna
OPENAI_MEMORY_MODEL=gpt-5.6-luna
OPENAI_SUMMARY_MODEL=gpt-5.6-luna
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_REASONING_EFFORT=low

MEMORY_TOP_K=5
RAG_TOP_K=5
CHAT_HISTORY_LIMIT=12
SUMMARY_TRIGGER_MESSAGES=12
MAX_OUTPUT_TOKENS=1000
RESET_STATE_ON_START=true

MEM0_VECTOR_PATH=.data/mem0_qdrant
MEM0_HISTORY_DB_PATH=.data/mem0_history.db
MEM0_COLLECTION_NAME=gyaru_chat_memories
CONVERSATION_DB_PATH=.data/conversations.db
RAG_EXAMPLES_PATH=data/gyaru_rag_documents.jsonl
RAG_CACHE_PATH=.data/few_shot_embeddings.json
